# Один игрок загадывает число, а второй пытается его угадать.
печать "Угадай число"
секрет = число ввод "Загадайте число от 1 до 100: "
попытки = 0
угадано = Ложь

пока не угадано
    ответ = число ввод "Ваша попытка: "
    попытки = попытки + 1
    если ответ меньше секрет
        печать "Загаданное число больше."
    иначе_если ответ больше секрет
        печать "Загаданное число меньше."
    иначе
        угадано = Истина
        печать "Верно! Количество попыток:" попытки
