функция вычислить а операция б
    если операция равно "+"
        вернуть а + б
    иначе_если операция равно "-"
        вернуть а - б
    иначе_если операция равно "*"
        вернуть а * б
    иначе_если операция равно "/"
        вернуть а / б
    иначе
        печать "Неизвестная операция"
        вернуть 0

печать "Консольный калькулятор"
первое = число ввод "Введите первое число: "
операция = ввод "Введите операцию + - * /: "
второе = число ввод "Введите второе число: "
результат = вычислить первое операция второе
печать "Результат:" результат
